# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required.

NODE_ENV=development
PORT=5000

# Postgres connection string. `npx prisma dev` prints one for a local database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixflow
# Most connections the API opens at once. Keep 1 for the local `prisma dev` database (it serves one at a time);
# remove it (default 10) for a real Postgres server.
DATABASE_POOL_MAX=1
# Only needed by `prisma migrate dev` when the database user can't create a shadow database.
SHADOW_DATABASE_URL=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Web app URL, used in invite links.
APP_URL=http://localhost:5173
# This API's public URL, used in signed file links (local storage driver).
PUBLIC_API_URL=http://localhost:5000
# Number of reverse proxies in front of the API in production (Render/Railway: 1).
TRUST_PROXY=0
LOG_LEVEL=info

# Attachment storage: "local" (disk, dev) or "s3" (AWS S3 / Cloudflare R2 / MinIO).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Signs file URLs; defaults to JWT_SECRET.
FILE_URL_SECRET=
FILE_URL_TTL_SECONDS=900

S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Web push alerts. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email for password reset links, sent with Resend (https://resend.com). Without a key, development logs the email.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. FixFlow <no-reply@yourdomain.com>
EMAIL_FROM=FixFlow <onboarding@resend.dev>

# Razorpay, for owners to pay for Pro online (optional). Leave the key empty to turn it off;
# the Buy button then emails VITE_CONTACT_EMAIL. Test keys (rzp_test_...) work without KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Sentry error tracking (optional). Leave empty to turn it off.
SENTRY_DSN=
