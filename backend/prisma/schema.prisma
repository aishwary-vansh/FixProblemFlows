// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  TECHNICIAN
  ADMIN
}

enum IssueStatus {
  NEW
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  phone        String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportedIssues Issue[] @relation("reportedIssues")
  assignedIssues Issue[] @relation("assignedIssues")
}

model Issue {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  location    String

  status   IssueStatus @default(NEW)
  priority Priority    @default(MEDIUM)

  reporterId Int
  assigneeId Int?

  reporter User  @relation("reportedIssues", fields: [reporterId], references: [id])
  assignee User? @relation("assignedIssues", fields: [assigneeId], references: [id])

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id        Int    @id @default(autoincrement())

  issueId   Int
  fileName  String
  fileUrl   String
  mimeType  String
  fileSize  Int

  issue     Issue  @relation(fields: [issueId], references: [id])

  createdAt DateTime @default(now())
}